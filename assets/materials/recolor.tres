		float blend = n_in9p1.z;
		if (base < 0.5) {
			n_out9p0.z = (base * (blend + 0.5));
		} else {
			n_out9p0.z = (1.0 - (1.0 - base) * (1.0 - (blend - 0.5)));
		}
	}


// Output:0
	COLOR.rgb = n_out9p0;


}
